{
  "name": "capillary-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "mcp": "node src/mcp/server.ts",
    "cdp:retv": "node scripts/cdp_retv_pipeline.ts",
    "review": "node scripts/review_cli.ts",
    "bench": "node scripts/celer_bench.ts",
    "test": "node --test --test-concurrency=1 'tests/**/*_test.ts'",
    "check": "tsc --noEmit -p .",
    "build:native": "./native/build.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "@xenova/transformers": "2.17.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "koffi": "^3.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "koffi@3.3.3": true,
    "sharp@0.32.6": true,
    "protobufjs@6.11.6": true
  }
}
